generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role { BUYER SELLER ADMIN DRIVER }
enum StoreStatus { PENDING APPROVED SUSPENDED REJECTED }
enum OrderStatus { PENDING_PAYMENT PAYMENT_REVIEW PAYMENT_CONFIRMED ACCEPTED PREPARING ASSIGNED_DELIVERY DELIVERING DELIVERED CANCELLED REJECTED }
enum PaymentMethod { CARD_TRANSFER PHONE_TRANSFER }
enum PaymentStatus { WAITING UNDER_REVIEW APPROVED REJECTED }

model User {
  id           String   @id @default(cuid())
  name         String?
  phone        String   @unique
  passwordHash String?
  role         Role     @default(BUYER)
  isActive     Boolean  @default(true)
  stores       Store[]
  orders       Order[]  @relation("BuyerOrders")
  deliveries   Order[]  @relation("DriverOrders")
  reviewedPay  Payment[] @relation("PaymentReviewer")
  auditLogs    AuditLog[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Store {
  id           String      @id @default(cuid())
  ownerId      String
  owner        User        @relation(fields: [ownerId], references: [id])
  name         String
  slug         String      @unique
  logoUrl      String?
  description  String?     @db.Text
  phone        String
  address      String
  latitude     Decimal?    @db.Decimal(10, 7)
  longitude    Decimal?    @db.Decimal(10, 7)
  workingHours String?
  status       StoreStatus @default(PENDING)
  products     Product[]
  orders       Order[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  imageUrl  String?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id          String   @id @default(cuid())
  storeId     String
  categoryId  String
  name        String
  slug        String
  description String?  @db.Text
  brand       String?
  unit        String
  price       Decimal  @db.Decimal(12, 2)
  oldPrice    Decimal? @db.Decimal(12, 2)
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  isApproved  Boolean  @default(false)
  store       Store    @relation(fields: [storeId], references: [id])
  category    Category @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([storeId, slug])
  @@index([categoryId, isActive, isApproved])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  buyerId         String
  storeId         String
  driverId        String?
  status          OrderStatus @default(PENDING_PAYMENT)
  subtotal        Decimal     @db.Decimal(12, 2)
  deliveryFee     Decimal     @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  buyerName       String
  buyerPhone      String
  deliveryAddress String
  deliveryNote    String?     @db.Text
  buyer           User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  store           Store       @relation(fields: [storeId], references: [id])
  driver          User?       @relation("DriverOrders", fields: [driverId], references: [id])
  items           OrderItem[]
  payment         Payment?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  @@index([buyerId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  price       Decimal @db.Decimal(12, 2)
  quantity    Int
  total       Decimal @db.Decimal(12, 2)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String        @unique
  method      PaymentMethod
  amount      Decimal       @db.Decimal(12, 2)
  status      PaymentStatus @default(WAITING)
  receiptUrl  String?
  receiptName String?
  receiptMime String?
  receiptData String?       @db.LongText
  reviewedBy  String?
  reviewedAt  DateTime?
  note        String?       @db.Text
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewer    User?         @relation("PaymentReviewer", fields: [reviewedBy], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  settingKey String  @unique
  value     String   @db.Text
  isPublic  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  String?  @db.Text
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  @@index([entity, entityId])
}
